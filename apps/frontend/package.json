{
  "name": "@stealth-scraper/frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Frontend UI for Stealth Web Scraper with modular horizontal architecture",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc && vite build",
    "preview": "vite preview --port 3000",
    "clear-cache": "powershell -Command \"Remove-Item -Recurse -Force node_modules/.vite,dist -ErrorAction SilentlyContinue; Write-Host '✅ clear-cache'\""
  },
  "dependencies": {
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.4.5",
    "vite": "^5.3.1"
  }
}
