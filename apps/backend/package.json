{
  "name": "@stealth-scraper/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend service for stealth web scraping with layered architecture",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "verify:proxy": "tsx src/scripts/verify-proxy.ts",
    "verify:proxy:json": "tsx src/scripts/verify-proxy.ts --json",
    "test:single": "tsx src/scripts/run-single-test.ts",
    "test:single:disable": "tsx src/scripts/disable-single-test.ts",
    "test:single:enable": "echo 'Configura SINGLE_TEST_MODE=true y ALLOW_DIRECT_IP=true en .env'"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "playwright": "^1.45.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.9",
    "tsx": "^4.16.0",
    "typescript": "^5.4.5"
  }
}
