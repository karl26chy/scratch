PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
HEADLESS_MODE=true
DEFAULT_STEALTH_LEVEL=advanced
MAX_CONCURRENT_BROWSERS=5
BROWSER_TIMEOUT_MS=30000

# --- PROXY RESIDENCIAL ROTATIVO (Webshare / BrightData / Custom) ---
# Activa proxies: true = usa PROXY_LIST_URL, false = IP directa (desarrollo)
PROXY_ENABLED=false
# Proveedor: webshare | brightdata | custom
PROXY_PROVIDER=webshare
# Lista de proxies: CSV "http://host:port,http://host2:port" o "socks5://user:pass@host:port"
# Ejemplo Webshare: "http://p.webshare.io:80,http://p.webshare.io:81"
# Ejemplo con JSON: '["http://user:pass@host:8000","socks5://user:pass@host:1080"]'
PROXY_LIST_URL=
# Credenciales globales (se aplican si no están embebidas en la URL)
PROXY_USERNAME=
PROXY_PASSWORD=
# API Key para proveedores que usan Auth Token (Webshare)
PROXY_API_KEY=
# URL para testear IP vía proxy (no requiere browser)
PROXY_TEST_URL=https://api.ipify.org?format=json

# ============================================
# MODO PRUEBA ÚNICA (ACTIVAR SOLO PARA UNA PRUEBA - LUEGO DESACTIVAR)
# ============================================
# ⚠️ SOLO UNA EJECUCIÓN CON IP DOMÉSTICA - DESPUÉS REVERTIR
SINGLE_TEST_MODE=false
ALLOW_DIRECT_IP=false
MAX_TEST_EXECUTIONS=1
TEST_URL=https://www.livescore.com

# ============================================
# MODO DEBUG (para prueba única visible)
# ============================================
# HEADLESS_MODE=false  # Descomenta para ver navegador en prueba única
